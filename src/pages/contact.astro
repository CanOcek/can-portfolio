---
import BaseLayout from "../layouts/BaseLayout.astro";

const contactLinks = [
  {
    label: "Email",
    href: "mailto:canocek@gmail.com",
    value: "canocek@gmail.com",
  },
  {
    label: "LinkedIn",
    href: "https://www.linkedin.com/in/can-%C3%B6cek-677620192/",
    value: "linkedin.com/in/can-öcek-677620192",
  },
  {
    label: "GitHub",
    href: "https://github.com/CanOcek",
    value: "github.com/CanOcek",
  },
  {
    label: "YouTube",
    href: "https://www.youtube.com/@CanOcekMusic",
    value: "@CanOcekMusic",
  },
];

const focusAreas = [
  {
    title: "AI-assisted research and retrieval tools",
    body: "Systems that collect, structure, retrieve, and explain messy information with enough evidence for a human reviewer to trust the result.",
  },
  {
    title: "Business-development and CRM systems",
    body: "Projects where data models, workflows, business context, and technical implementation need to fit together clearly.",
  },
  {
    title: "Product-facing technical work",
    body: "Interfaces, demos, dashboards, and prototypes that make complex technical behavior understandable to the people using it.",
  },
] as const;
---

<BaseLayout
  title="Contact"
  description="Contact Can Öcek for technical work, thesis conversations, business-system projects, and media collaboration."
>
  <header class="page-header container narrow">
    <p class="eyebrow">Contact</p>
    <h1>Let's talk</h1>
    <p class="lede">
      I am open to conversations about technical projects, working-student roles, bachelor's thesis
      topics, business-system work, and selected media or creative-production collaboration.
    </p>
    <div class="button-row" aria-label="Contact actions">
      <a class="button primary" href="mailto:canocek@gmail.com">Email me</a>
      <a class="button" href="/pdfs/Can%20Ocek%20CV.pdf" download>Download CV</a>
    </div>
  </header>

  <section class="section current-focus-section" aria-labelledby="current-focus-title">
    <div class="container two-column">
      <div>
        <p class="eyebrow">Current focus</p>
        <h2 id="current-focus-title">What I am looking for</h2>
      </div>
      <div class="stack">
        <p class="lede">
          I am especially interested in working-student roles, thesis topics, and project
          conversations around business intelligence, retrieval-augmented workflows, practical
          data pipelines, and product-facing technical systems.
        </p>
        <ul class="meta-list">
          {
            focusAreas.map((area) => (
              <li>
                <strong>{area.title}</strong>
                <p>{area.body}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="contact-links-title">
    <div class="container two-column">
      <div>
        <p class="eyebrow">Links</p>
        <h2 id="contact-links-title">Find me online</h2>
      </div>
      <ul class="meta-list">
        {
          contactLinks.map((link) => (
            <li>
              <strong>{link.label}</strong>
              <p>
                <a href={link.href}>{link.value}</a>
              </p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="contact-routes-title">
    <div class="container two-column">
      <div>
        <p class="eyebrow">Routes</p>
        <h2 id="contact-routes-title">What to contact me about</h2>
      </div>
      <div class="stack">
        <ul class="meta-list">
          <li>
            <strong>Working-student, thesis, and technical projects</strong>
            <p>
              I am open to software, AI-assisted retrieval, data pipelines, automation, bachelor's
              thesis topics, and practical systems that need to be built clearly.
            </p>
          </li>
          <li>
            <strong>Business systems and CRM</strong>
            <p>
              I am interested in work that connects business processes, data models, workflows, and
              technical implementation.
            </p>
          </li>
          <li>
            <strong>Media and creative production</strong>
            <p>
              I am open to audio, video, photography, and creative-technology projects where
              technical execution and presentation both matter.
            </p>
          </li>
        </ul>
        <div class="button-row">
          <a class="button primary" href="/work/">Browse projects</a>
          <a class="button" href="/media/">Media</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .current-focus-section {
    background:
      linear-gradient(115deg, rgb(126 199 190 / 0.08), transparent 42%),
      var(--color-bg-soft);
  }
</style>
