---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";

const proofOrder = [
  "salesforce-record-label-crm",
  "magnetic-liquid-lens-microscope",
  "libgdx-top-down-roguelike",
];

const proofProjects = (await getCollection("projects"))
  .filter((project) => proofOrder.includes(project.id))
  .sort((a, b) => proofOrder.indexOf(a.id) - proofOrder.indexOf(b.id));

const projectLenses = [
  {
    id: "systems",
    tab: "Data & strategy",
    index: "01",
    eyebrow: "Flagship system",
    title: "Turn open-web noise into decisions.",
    description:
      "The Business Development Radar collects public company signals, removes noise, retrieves evidence, and turns it into an inspectable business-development view.",
    image: "/images/projects/radar-extracted/radar-pdf-obj-203.png",
    imageAlt: "Six-layer architecture diagram for the Business Development Radar pipeline.",
    imageLabel: "67 sources · 21 companies",
    accent: "teal",
    facts: [
      ["54.41×", "less downstream LLM input"],
      ["13,753", "evidence units classified"],
      ["1,523", "useful signals retained"],
    ],
    role: "Collection, processing, retrieval, synthesis, and product workflow.",
    primaryHref: "/radar/",
    primaryLabel: "Try the demo",
    secondaryHref: "/work/web-intelligence-rag-pipeline/",
    secondaryLabel: "Read case study",
  },
  {
    id: "algorithms",
    tab: "Algorithms",
    index: "02",
    eyebrow: "Interactive research",
    title: "Make an algorithm visible while it thinks.",
    description:
      "A browser-native maze lab lets you compare Dijkstra and A* on the same generated world, then connect what you see to the measured research result.",
    image: "/images/projects/maze-pathfinding-cover.png",
    imageAlt: "Generated maze grid used in the pathfinding comparison project.",
    imageLabel: "Live TypeScript demo",
    accent: "blue",
    facts: [
      ["2", "algorithms, one maze"],
      ["50", "seeded trials per size"],
      ["41.5%", "fewer cells searched by A*"],
    ],
    role: "Research design, maze generation, implementation, and analysis.",
    primaryHref: "/work/dijkstra-vs-a-star/",
    primaryLabel: "Open the maze lab",
    secondaryHref: "/work/",
    secondaryLabel: "Browse technical work",
  },
  {
    id: "creative",
    tab: "Sound & image",
    index: "03",
    eyebrow: "Creative practice",
    title: "Treat production as a complete system.",
    description:
      "A concise media selection connects concert photography with one completed music-video production.",
    image: "/images/photography/live-music/featured-live-crowd.jpg",
    imageAlt: "Live performer facing an audience under concert lighting.",
    imageLabel: "Performance · production · media",
    accent: "orange",
    facts: [
      ["4", "selected concert frames"],
      ["1", "completed video production"],
      ["1", "focused media section"],
    ],
    role: "Photography, arrangement, recording, video editing, and color grading.",
    primaryHref: "/media/",
    primaryLabel: "View selected media",
    secondaryHref: "/contact/",
    secondaryLabel: "Get in touch",
  },
];

const processSteps = [
  {
    id: "frame",
    index: "01",
    label: "Frame",
    title: "Find the actual question.",
    text: "I start by reducing an open-ended brief to a clear decision, audience, and success condition. That keeps the work useful before it becomes technically impressive.",
    proof: "Radar: public data should support a reviewer, not replace one.",
  },
  {
    id: "build",
    index: "02",
    label: "Build",
    title: "Make the smallest complete system.",
    text: "I connect the pieces that prove the workflow end to end: source, transformation, interface, and result. The seams stay visible enough to inspect and improve.",
    proof: "Maze lab: generation, solving, animation, and measurement in one browser flow.",
  },
  {
    id: "test",
    index: "03",
    label: "Test",
    title: "Measure what changes.",
    text: "I compare outputs, expose evidence, and look for failure modes. A result becomes credible when the path to it is understandable.",
    proof: "A* and Dijkstra return the same path, but search very different amounts of the maze.",
  },
  {
    id: "communicate",
    index: "04",
    label: "Communicate",
    title: "Turn the result into a story.",
    text: "I shape the interface, visuals, and language around the person using the work. The portfolio is part of that practice—not a separate layer added at the end.",
    proof: "One project can be entered through the demo, architecture, evidence, or case study.",
  },
];
---

<BaseLayout
  title="Can Ocek Portfolio"
  description="Can Öcek builds evidence-backed software, business systems, interactive technical work, and selected media."
>
  <section
    class="home-hero container"
    aria-labelledby="home-title"
    data-section-label="Introduction"
  >
    <div class="home-hero__copy" data-reveal>
      <p class="eyebrow">Can Öcek · multidisciplinary builder</p>
      <h1 id="home-title">I turn scattered signals into systems people can use.</h1>
      <p class="home-hero__lede">
        Software, business context, and creative production meet in one practice:
        understand the system, find the missing link, and make the result legible.
      </p>
      <div class="button-row" aria-label="Primary actions">
        <a class="button primary" href="#selected-work">Explore selected work</a>
        <a class="button" href="/contact/">Start a conversation</a>
      </div>
    </div>

    <aside class="entry-points" aria-labelledby="entry-points-title" data-reveal>
      <div class="entry-points__header">
        <p id="entry-points-title">Choose an entry point</p>
        <span aria-hidden="true">↘</span>
      </div>
      <a href="#project-systems" data-lens-target="systems">
        <span>01</span>
        <strong>Data & strategy</strong>
        <small>Evidence-backed intelligence</small>
      </a>
      <a href="#project-algorithms" data-lens-target="algorithms">
        <span>02</span>
        <strong>Algorithms</strong>
        <small>Research you can interact with</small>
      </a>
      <a href="#project-creative" data-lens-target="creative">
        <span>03</span>
        <strong>Sound & image</strong>
        <small>Production from stage to screen</small>
      </a>
    </aside>

    <div class="home-hero__footer" data-reveal>
      <p>Management & Technology at TUM · Computer-science foundation</p>
      <a href="#selected-work">Scroll to explore <span aria-hidden="true">↓</span></a>
    </div>
  </section>

  <section
    id="selected-work"
    class="section project-journey"
    aria-labelledby="journey-title"
    data-project-explorer
    data-section-label="Selected work"
  >
    <div class="container">
      <div class="section-heading" data-reveal>
        <div>
          <p class="eyebrow">Selected work</p>
          <h2 id="journey-title">Three ways into the portfolio.</h2>
        </div>
        <p>
          Switch the lens to see how the same working style moves between strategic data,
          algorithmic research, and creative production.
        </p>
      </div>

      <div class="lens-tabs" role="tablist" aria-label="Portfolio lenses" data-reveal>
        {
          projectLenses.map((lens, index) => (
            <button
              id={`tab-${lens.id}`}
              class:list={["lens-tab", { "is-active": index === 0 }]}
              type="button"
              role="tab"
              aria-selected={index === 0 ? "true" : "false"}
              aria-controls={`project-${lens.id}`}
              tabindex={index === 0 ? "0" : "-1"}
              data-project-tab={lens.id}
            >
              <span>{lens.index}</span>
              {lens.tab}
            </button>
          ))
        }
      </div>

      <div class="lens-stage" data-reveal>
        {
          projectLenses.map((lens, index) => (
            <article
              id={`project-${lens.id}`}
              class={`lens-panel lens-panel--${lens.accent}`}
              role="tabpanel"
              aria-labelledby={`tab-${lens.id}`}
              hidden={index !== 0}
              data-project-panel={lens.id}
            >
              <div class="lens-panel__media">
                <img src={lens.image} alt={lens.imageAlt} loading={index === 0 ? "eager" : "lazy"} />
                <span>{lens.imageLabel}</span>
              </div>
              <div class="lens-panel__content">
                <p class="eyebrow">{lens.eyebrow}</p>
                <h3>{lens.title}</h3>
                <p class="lens-panel__description">{lens.description}</p>
                <dl class="lens-panel__facts">
                  {
                    lens.facts.map(([value, label]) => (
                      <div>
                        <dt>{value}</dt>
                        <dd>{label}</dd>
                      </div>
                    ))
                  }
                </dl>
                <p class="lens-panel__role">
                  <span>My role</span>
                  {lens.role}
                </p>
                <div class="button-row">
                  <a class="button primary" href={lens.primaryHref}>{lens.primaryLabel}</a>
                  <a class="button" href={lens.secondaryHref}>{lens.secondaryLabel}</a>
                </div>
              </div>
            </article>
          ))
        }
      </div>
      <p class="sr-only" aria-live="polite" data-project-status></p>
    </div>
  </section>

  <section
    class="section process-section"
    aria-labelledby="process-title"
    data-process-flow
    data-section-label="Working method"
  >
    <div class="container">
      <div class="section-heading section-heading--compact" data-reveal>
        <div>
          <p class="eyebrow">Working method</p>
          <h2 id="process-title">A process with a visible pulse.</h2>
        </div>
        <p>Move through the four steps. Each one changes what the next step needs.</p>
      </div>

      <div class="process-flow" data-reveal>
        <div class="process-flow__steps" role="tablist" aria-label="Working process">
          {
            processSteps.map((step, index) => (
              <button
                id={`process-tab-${step.id}`}
                class:list={["process-step", { "is-active": index === 0 }]}
                type="button"
                role="tab"
                aria-selected={index === 0 ? "true" : "false"}
                aria-controls={`process-panel-${step.id}`}
                tabindex={index === 0 ? "0" : "-1"}
                data-process-tab={step.id}
              >
                <span>{step.index}</span>
                <strong>{step.label}</strong>
              </button>
            ))
          }
        </div>
        <div class="process-flow__content">
          {
            processSteps.map((step, index) => (
              <article
                id={`process-panel-${step.id}`}
                role="tabpanel"
                aria-labelledby={`process-tab-${step.id}`}
                hidden={index !== 0}
                data-process-panel={step.id}
              >
                <p class="process-flow__counter">Step {step.index} / 04</p>
                <h3>{step.title}</h3>
                <p class="lede">{step.text}</p>
                <p class="process-flow__proof"><span>In practice</span>{step.proof}</p>
              </article>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section class="section proof-section" aria-labelledby="proof-title" data-section-label="More proof">
    <div class="container">
      <div class="section-heading" data-reveal>
        <div>
          <p class="eyebrow">More proof points</p>
          <h2 id="proof-title">Different domains. The same curiosity.</h2>
        </div>
        <p>
          Earlier technical work, business systems, and physical experimentation show how the
          practice developed.
        </p>
      </div>
      <div class="proof-grid" data-reveal>
        {proofProjects.map((project) => <ProjectCard project={project} />)}
      </div>
      <div class="section-action" data-reveal>
        <a class="text-link" href="/work/">See the complete project archive <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>

  <section class="section creative-section" aria-labelledby="creative-title" data-section-label="Creative work">
    <div class="container creative-stage">
      <div class="creative-stage__image" data-reveal>
        <img
          src="/images/photography/live-music/wonuola-crowd-perspective.jpg"
          alt="Live musician seen from the audience under warm stage lights."
          loading="lazy"
        />
        <span>Munich · live music archive</span>
      </div>
      <div class="creative-stage__copy" data-reveal>
        <p class="eyebrow">Beyond the interface</p>
        <h2 id="creative-title">Media sharpens how I frame and communicate.</h2>
        <p class="lede">
          Photography, audio, and video production train the same judgment I bring to technical
          work: choose the right frame, shape the sequence, and make the result legible.
        </p>
        <div class="creative-links">
          <a href="/media/">
            <span>01</span>
            <strong>Selected media</strong>
            <small>Concert photography and one completed music-video production</small>
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="section closing-section" aria-labelledby="contact-title" data-section-label="Contact">
    <div class="container closing-stage" data-reveal>
      <p class="eyebrow">Next chapter</p>
      <h2 id="contact-title">Have a complex idea that needs a clear shape?</h2>
      <p>
        I’m interested in technical work, business systems, research, thesis conversations,
        and creative collaborations where different disciplines need to meet.
      </p>
      <div class="button-row">
        <a class="button primary" href="/contact/">Start a conversation</a>
        <a class="button" href="/about/">More about me</a>
        <a class="button" href="/cv/">View CV</a>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const setupTabFlow = (
    rootSelector: string,
    tabSelector: string,
    panelSelector: string,
    tabDataKey: "projectTab" | "processTab",
    panelDataKey: "projectPanel" | "processPanel",
  ) => {
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    document.querySelectorAll<HTMLElement>(rootSelector).forEach((root) => {
      const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>(tabSelector));
      const panels = Array.from(root.querySelectorAll<HTMLElement>(panelSelector));

      const activate = (id: string, focus = false) => {
        tabs.forEach((tab) => {
          const active = tab.dataset[tabDataKey] === id;
          tab.classList.toggle("is-active", active);
          tab.setAttribute("aria-selected", active ? "true" : "false");
          tab.tabIndex = active ? 0 : -1;
          if (active && focus) tab.focus();
        });

        panels.forEach((panel) => {
          const active = panel.dataset[panelDataKey] === id;
          panel.hidden = !active;
          if (active && !reduceMotion) {
            panel.animate(
              [
                { opacity: 0, transform: "translateY(12px)" },
                { opacity: 1, transform: "translateY(0)" },
              ],
              { duration: 360, easing: "cubic-bezier(.2,.8,.2,1)" },
            );
          }
        });

        const status = root.querySelector<HTMLElement>("[data-project-status]");
        const activeTab = tabs.find((tab) => tab.dataset[tabDataKey] === id);
        if (status && activeTab) status.textContent = `${activeTab.textContent?.trim()} selected`;
      };

      tabs.forEach((tab, index) => {
        tab.addEventListener("click", () => activate(tab.dataset[tabDataKey] ?? ""));
        tab.addEventListener("keydown", (event) => {
          const keys = ["ArrowRight", "ArrowDown", "ArrowLeft", "ArrowUp", "Home", "End"];
          if (!keys.includes(event.key)) return;
          event.preventDefault();

          let nextIndex = index;
          if (event.key === "ArrowRight" || event.key === "ArrowDown") {
            nextIndex = (index + 1) % tabs.length;
          } else if (event.key === "ArrowLeft" || event.key === "ArrowUp") {
            nextIndex = (index - 1 + tabs.length) % tabs.length;
          } else if (event.key === "Home") {
            nextIndex = 0;
          } else if (event.key === "End") {
            nextIndex = tabs.length - 1;
          }
          activate(tabs[nextIndex].dataset[tabDataKey] ?? "", true);
        });
      });

      root.addEventListener("activate-flow", (event) => {
        const customEvent = event as CustomEvent<string>;
        activate(customEvent.detail);
      });
    });
  };

  setupTabFlow(
    "[data-project-explorer]",
    "[data-project-tab]",
    "[data-project-panel]",
    "projectTab",
    "projectPanel",
  );
  setupTabFlow(
    "[data-process-flow]",
    "[data-process-tab]",
    "[data-process-panel]",
    "processTab",
    "processPanel",
  );

  document.querySelectorAll<HTMLAnchorElement>("[data-lens-target]").forEach((link) => {
    link.addEventListener("click", (event) => {
      event.preventDefault();
      const explorer = document.querySelector<HTMLElement>("[data-project-explorer]");
      const lens = link.dataset.lensTarget;
      if (!explorer || !lens) return;
      explorer.dispatchEvent(new CustomEvent("activate-flow", { detail: lens }));
      explorer.scrollIntoView({ behavior: "smooth", block: "start" });
    });
  });
</script>

<style>
  .home-hero {
    display: grid;
    gap: clamp(2.5rem, 6vw, 6rem);
    grid-template-columns: minmax(0, 1.18fr) minmax(19rem, 0.62fr);
    min-height: calc(100svh - 5.25rem);
    padding-block: clamp(4rem, 10vh, 8rem) var(--space-5);
  }

  .home-hero__copy {
    align-self: center;
    max-width: 55rem;
  }

  .home-hero h1 {
    font-size: clamp(3.4rem, 7.2vw, 7.5rem);
    letter-spacing: -0.055em;
    line-height: 0.94;
    max-width: 11ch;
    text-wrap: balance;
  }

  .home-hero__lede {
    color: var(--color-text);
    font-size: clamp(1.2rem, 2vw, 1.55rem);
    line-height: 1.5;
    margin-block-start: var(--space-6);
    max-width: 44rem;
  }

  .entry-points {
    align-self: center;
    background: rgb(11 13 17 / 0.68);
    border: var(--border-subtle);
    border-radius: 1.25rem;
    box-shadow: var(--shadow-soft);
    overflow: hidden;
  }

  .entry-points__header {
    align-items: center;
    color: var(--color-text-subtle);
    display: flex;
    font-size: 0.78rem;
    justify-content: space-between;
    padding: var(--space-4) var(--space-5);
    text-transform: uppercase;
  }

  .entry-points__header p {
    color: inherit;
  }

  .entry-points > a {
    align-items: center;
    border-block-start: var(--border-subtle);
    display: grid;
    gap: var(--space-2) var(--space-4);
    grid-template-columns: auto 1fr;
    padding: var(--space-5);
    text-decoration: none;
    transition:
      background var(--transition-fast),
      color var(--transition-fast);
  }

  .entry-points > a:hover,
  .entry-points > a:focus-visible {
    background: var(--color-surface-strong);
    color: var(--color-text);
  }

  .entry-points > a span {
    color: var(--color-accent-strong);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    grid-row: 1 / 3;
  }

  .entry-points > a strong {
    color: var(--color-text);
    font-family: var(--font-serif);
    font-size: 1.45rem;
    font-weight: 500;
    line-height: 1.1;
  }

  .entry-points > a small {
    color: var(--color-text-subtle);
    font-size: 0.86rem;
  }

  .home-hero__footer {
    align-items: center;
    border-block-start: var(--border-subtle);
    display: flex;
    gap: var(--space-5);
    grid-column: 1 / -1;
    justify-content: space-between;
    padding-block-start: var(--space-5);
  }

  .home-hero__footer p,
  .home-hero__footer a {
    color: var(--color-text-subtle);
    font-size: 0.82rem;
  }

  .home-hero__footer a {
    text-decoration: none;
  }

  .section-heading {
    align-items: end;
    display: grid;
    gap: var(--space-7);
    grid-template-columns: minmax(0, 1.25fr) minmax(18rem, 0.58fr);
    margin-block-end: var(--space-7);
  }

  .section-heading h2 {
    font-size: clamp(2.8rem, 5.2vw, 5.25rem);
    letter-spacing: -0.045em;
    max-width: 12ch;
    text-wrap: balance;
  }

  .section-heading > p {
    font-size: 1.05rem;
  }

  .section-heading--compact h2 {
    max-width: 10ch;
  }

  .project-journey {
    background:
      radial-gradient(circle at 78% 24%, rgb(126 199 190 / 0.11), transparent 24rem),
      var(--color-bg-soft);
    scroll-margin-top: 5rem;
  }

  .lens-tabs {
    border-block: var(--border-subtle);
    display: grid;
    grid-template-columns: repeat(3, 1fr);
  }

  .lens-tab {
    align-items: center;
    background: transparent;
    border: 0;
    border-inline-start: var(--border-subtle);
    color: var(--color-text-muted);
    cursor: pointer;
    display: flex;
    font: inherit;
    font-weight: 700;
    gap: var(--space-3);
    justify-content: center;
    min-height: 4.5rem;
    padding: var(--space-3);
    transition:
      background var(--transition-fast),
      color var(--transition-fast);
  }

  .lens-tab:first-child {
    border-inline-start: 0;
  }

  .lens-tab span {
    color: var(--color-text-subtle);
    font-family: var(--font-mono);
    font-size: 0.74rem;
  }

  .lens-tab:hover,
  .lens-tab.is-active {
    background: var(--color-surface);
    color: var(--color-text);
  }

  .lens-tab.is-active span {
    color: var(--color-accent-strong);
  }

  .lens-stage {
    min-height: 42rem;
    padding-block-start: var(--space-6);
  }

  .lens-panel {
    --panel-accent: var(--color-cool);
    background: linear-gradient(150deg, color-mix(in srgb, var(--panel-accent) 10%, transparent), transparent 36%);
    border: var(--border-subtle);
    border-radius: 1.4rem;
    display: grid;
    gap: var(--space-7);
    grid-template-columns: minmax(0, 1.1fr) minmax(21rem, 0.9fr);
    min-height: 40rem;
    overflow: hidden;
    padding: clamp(var(--space-4), 3.5vw, var(--space-7));
  }

  .lens-panel--blue {
    --panel-accent: var(--color-blue);
  }

  .lens-panel--orange {
    --panel-accent: var(--color-accent);
  }

  .lens-panel__media {
    align-self: stretch;
    background: var(--color-bg);
    border: 1px solid color-mix(in srgb, var(--panel-accent) 34%, var(--color-border));
    border-radius: 1rem;
    min-height: 30rem;
    overflow: hidden;
    position: relative;
  }

  .lens-panel__media::after {
    background: linear-gradient(180deg, transparent 55%, rgb(5 6 8 / 0.76));
    content: "";
    inset: 0;
    pointer-events: none;
    position: absolute;
  }

  .lens-panel__media img {
    height: 100%;
    object-fit: cover;
    width: 100%;
  }

  .lens-panel--teal .lens-panel__media img {
    object-fit: contain;
    padding: var(--space-4);
  }

  .lens-panel__media span {
    background: rgb(5 6 8 / 0.72);
    border: 1px solid rgb(255 255 255 / 0.14);
    border-radius: 999px;
    bottom: var(--space-4);
    color: var(--color-text);
    font-size: 0.78rem;
    left: var(--space-4);
    padding: 0.45rem 0.7rem;
    position: absolute;
    z-index: 1;
  }

  .lens-panel__content {
    align-content: center;
    display: grid;
    gap: var(--space-5);
  }

  .lens-panel__content .eyebrow {
    color: var(--panel-accent);
    margin: 0;
  }

  .lens-panel h3 {
    font-size: clamp(2.6rem, 4.4vw, 4.7rem);
    letter-spacing: -0.045em;
    max-width: 10ch;
    text-wrap: balance;
  }

  .lens-panel__description {
    color: var(--color-text);
    font-size: 1.1rem;
  }

  .lens-panel__facts {
    border-block: var(--border-subtle);
