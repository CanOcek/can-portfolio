---
interface Props {
  outcome?: {
    intro: string;
    takeaways: string[];
  };
}

const { outcome } = Astro.props;
---

{
  outcome && (
    <section class="section personal-outcome" aria-labelledby="personal-outcome-title">
      <div class="container two-column">
        <div>
          <p class="eyebrow">Personal outcome</p>
          <h2 id="personal-outcome-title">What I took from it</h2>
        </div>
        <div class="personal-outcome__panel">
          <p>{outcome.intro}</p>
          <ul class="personal-outcome__list">
            {outcome.takeaways.map((takeaway) => <li>{takeaway}</li>)}
          </ul>
        </div>
      </div>
    </section>
  )
}

<style>
  .personal-outcome {
    background:
      linear-gradient(115deg, rgb(213 139 84 / 0.08), transparent 42%),
      var(--color-bg-soft);
  }

  .personal-outcome__panel {
    background: var(--color-surface);
    border: var(--border-subtle);
    border-radius: var(--radius-md);
    display: grid;
    gap: var(--space-5);
    padding: var(--space-5);
  }

  .personal-outcome__panel > p {
    color: var(--color-text);
    font-size: 1.05rem;
  }

  .personal-outcome__list {
    display: grid;
    gap: var(--space-3);
    list-style: none;
    padding: 0;
  }

  .personal-outcome__list li {
    border-block-start: var(--border-subtle);
    color: var(--color-text-muted);
    padding-block-start: var(--space-3);
  }
</style>
