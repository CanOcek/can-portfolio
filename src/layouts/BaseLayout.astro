---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  contextLabel?: string;
}

const defaultTitle = "Can Öcek Portfolio";
const {
  title = defaultTitle,
  description = "Can Öcek's portfolio across technology, strategy, business systems, and selected media.",
  contextLabel = title === defaultTitle ? "Portfolio" : title,
} = Astro.props;

const pageTitle = title === defaultTitle ? title : `${title} | Can Öcek`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <script is:inline>document.documentElement.classList.add("js");</script>
  </head>
  <body>
    <div class="scroll-progress" aria-hidden="true">
      <span data-scroll-progress></span>
    </div>
    <a class="skip-link" href="#content">Skip to content</a>
    <div class="site-shell">
      <Header contextLabel={contextLabel} />
      <main id="content" class="site-main" tabindex="-1">
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>

<script>
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const progress = document.querySelector<HTMLElement>("[data-scroll-progress]");
  const sectionReadout = document.querySelector<HTMLElement>("[data-section-readout]");
  const sections = Array.from(document.querySelectorAll<HTMLElement>("[data-section-label]"));
  const defaultSectionReadout = sectionReadout?.dataset.defaultSectionReadout ?? "Portfolio";

  const updateScrollState = () => {
    const scrollable = document.documentElement.scrollHeight - window.innerHeight;
    const ratio = scrollable > 0 ? Math.min(1, Math.max(0, window.scrollY / scrollable)) : 0;
    if (progress) progress.style.transform = `scaleX(${ratio})`;

    if (sectionReadout && sections.length) {
      const active =
        [...sections].reverse().find((section) => section.getBoundingClientRect().top <= 240) ??
        sections[0];
      sectionReadout.textContent = active.dataset.sectionLabel ?? defaultSectionReadout;
    }
  };

  updateScrollState();
  window.addEventListener("scroll", updateScrollState, { passive: true });
  window.addEventListener("resize", updateScrollState, { passive: true });

  const revealTargetSelector = window.location.hash ? decodeURIComponent(window.location.hash) : "";
  const revealHashTarget =
    revealTargetSelector && revealTargetSelector.startsWith("#")
      ? document.getElementById(revealTargetSelector.slice(1))
      : null;
  const revealAncestors = revealHashTarget
    ? [revealHashTarget, ...Array.from(revealHashTarget.closest("[data-reveal]") ? [revealHashTarget.closest("[data-reveal]") as HTMLElement] : [])]
    : [];
  revealAncestors.forEach((element) => element.classList.add("is-visible"));

  const reveals = document.querySelectorAll<HTMLElement>("[data-reveal]");
  if (reduceMotion || !("IntersectionObserver" in window)) {
    reveals.forEach((element) => element.classList.add("is-visible"));
  } else {
    const revealObserver = new IntersectionObserver(
      (entries, observer) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add("is-visible");
          observer.unobserve(entry.target);
        });
      },
      { rootMargin: "0px 0px -8% 0px", threshold: 0.08 },
    );
    reveals.forEach((element) => revealObserver.observe(element));
  }
</script>
